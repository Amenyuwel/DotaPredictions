# Compute server. Copy to server/.env for local development.

PORT=3000

# Where the published run comes from. With neither of these set the server
# still boots and reports "unconfigured" rather than crashing -- a missing
# database is a deployment problem to fix, not corrupt data to refuse.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Pin which snapshot to serve. Leave both empty for the newest current run.
TOURNAMENT_ID=
STAGE=

# Local dev: point the server at a publish.py --out payload instead of the
# database. Takes precedence over SUPABASE_URL, and is validated by the same
# schema on the same code path -- a shortcut around the database, not around
# the contract.
RUN_FILE=../run-main.json
