# Compute server. Copy to server/.env for local development.

PORT=3000

# Atlas free tier is fine. With this unset the server still boots and reports
# "unconfigured" rather than crashing -- a missing database is a deployment
# problem to fix, not corrupt data to refuse.
MONGODB_URI=
MONGODB_DB=dotapredictions

# Pin which snapshot to serve. Leave both empty for the newest current run.
TOURNAMENT_ID=
STAGE=
