{
  // Static hosting for the built client on the `dotapredictions` Worker.
  //
  // At the repo root, not in client/, because Workers Builds runs preview
  // (non-production branch) builds from the root with no build command, even
  // with a root directory set in the dashboard. So this file builds the client
  // itself rather than trusting a dashboard setting it cannot see.
  //
  // Only client/dist is uploaded: pointing assets at client/ itself shipped the
  // raw source, and the browser cannot run /src/main.tsx.
  "name": "dotapredictions",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm ci --prefix client && npm run build --prefix client"
  },
  "assets": {
    "directory": "./client/dist",
    // Client-side routes such as /admin have no file; serve the app for them.
    "not_found_handling": "single-page-application",
    // ...but never for the API, or a missing server reads as a 200 of HTML.
    "run_worker_first": ["/api/*"]
  },
  // Non-production branches deploy with `wrangler preview`, which refuses to
  // run without this block. Empty is enough: assets and compatibility settings
  // stay at the top level.
  "previews": {}
}
