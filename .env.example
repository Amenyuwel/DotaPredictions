# Engine keys. Both optional; OpenDota works keyless and these only speed
# things up.

# Free key from https://stratz.com/api -- enables bulk stat fetching.
STRATZ_API_TOKEN=

# Free key from https://www.opendota.com/api-keys -- raises the rate limit.
OPENDOTA_API_KEY=

# --------------------------------------------------------------------------
# Supabase
# --------------------------------------------------------------------------
# One project serves two unrelated purposes: it stores published runs (read by
# the Express server) and it authenticates users so they can save banners.
#
# Vite reads this file directly (client/vite.config.ts sets envDir to the repo
# root), and it exposes ONLY the VITE_-prefixed names to the browser bundle.
# That is the whole reason the secret key below has no prefix.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only: publish.py writes runs with it, and the Express server
# reads them with it. It carries BYPASSRLS, which is why public.runs has
# row-level security on and no policy at all. Never prefix it with VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --------------------------------------------------------------------------
# Local admin login  --  DEVELOPMENT ONLY
# --------------------------------------------------------------------------
# Replaces the Supabase session AND the public.admins check with a username and
# password, so the configuration editor at /admin can be used before OAuth
# redirect URIs are registered with a provider.
#
# Off unless ADMIN_DEV_LOGIN is exactly "1", and there are no default
# credentials to fall back on. The server REFUSES TO START with this set and
# NODE_ENV=production: a shortcut that fails loudly in the one environment it
# must not be in is a shortcut, one that merely warns is a vulnerability.
#
# Anyone who can reach the page and knows the pair can rewrite the scoring
# table every visitor's projection is computed from. Use a real Supabase
# session and a public.admins row for anything deployed.
ADMIN_DEV_LOGIN=
ADMIN_DEV_USERNAME=
ADMIN_DEV_PASSWORD=
ADMIN_DEV_SECRET=      # any long random string; `openssl rand -hex 32`
